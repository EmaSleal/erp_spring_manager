# ============================================================================
# VARIABLES DE ENTORNO - ERP Orders Manager
# ============================================================================
# Este archivo contiene un ejemplo de las variables de entorno necesarias.
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas el archivo .env.local al repositorio (debe estar en .gitignore)
# Todos los valores de este archivo son de ejemplo: no son credenciales reales.
# ============================================================================

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DB_URL=jdbc:mysql://localhost:3306/nombre_base_datos?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=usuario
DB_PASSWORD=contraseña
# Nombre de la base de datos (obligatorio en docker-compose; sin valor por defecto)
DB_NAME=nombre_base_datos

# ========================================
# APLICACIÓN
# ========================================
SERVER_PORT=
# URL pública de la aplicación (obligatoria; sin valor por defecto)
APP_BASE_URL=https://erp.tu-dominio.com
# Orígenes permitidos para CORS, separados por coma (obligatorio; sin valor por defecto)
CORS_ALLOWED_ORIGINS=https://erp.tu-dominio.com

# ========================================
# CIFRADO DE CREDENCIALES
# ========================================
# Clave AES de 32 bytes en Base64 (generar con: openssl rand -base64 32).
# Cifra las credenciales de Hacienda y la contraseña SMTP. Respaldarla aparte, nunca en la BD.
HACIENDA_CRYPTO_KEY=
# Solo si alguna contraseña SMTP guardada usa el formato anterior "{enc}": al arrancar se
# descifra con esta clave y se vuelve a cifrar con HACIENDA_CRYPTO_KEY. Si no, dejar vacía.
SMTP_ENCRYPTION_KEY=

# ========================================
# ADMIN DE BOOTSTRAP
# ========================================
# Solo se usan si no existe ningún usuario activo con rol ADMIN: se crea "Administrador"
# con cambio de contraseña obligatorio en el primer ingreso. Con un ADMIN activo se ignoran.
# La contraseña debe tener al menos 12 caracteres.
BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
BOOTSTRAP_ADMIN_TELEFONO=00000000
BOOTSTRAP_ADMIN_PASSWORD=
# ========================================
# CORREO (SMTP)
# ========================================
# El SMTP no se configura con variables de entorno: se configura en la aplicación, en
# Configuración → Email (host, usuario y contraseña de aplicación). Después se ejecuta la
# prueba de envío y recién entonces se activa el envío.
# Para Gmail, usa una "Contraseña de aplicación" (https://myaccount.google.com/apppasswords),
# no tu contraseña normal.

# ========================================
# WHATSAPP META BUSINESS API
# ========================================
# Phone Number ID (obtenido de Meta Developer Console)
META_WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id

# Access Token temporal (24 horas)
# Regenerar diariamente en: WhatsApp → API Setup → Generate token
META_WHATSAPP_ACCESS_TOKEN=tu-access-token

# API Version
META_WHATSAPP_API_VERSION=v18.0

# Base URL de la API
META_WHATSAPP_API_URL=https://graph.facebook.com

# Webhook Verify Token (generar un token único y seguro)
META_WEBHOOK_VERIFY_TOKEN=tu-webhook-verify-token

# ========================================
# NOTAS IMPORTANTES
# ========================================
# - Nunca compartas tus credenciales
# - Asegúrate de que .env esté en .gitignore
# - Para producción, usa variables de entorno del servidor
